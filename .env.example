# Copy to .env.local. These defaults work as-is with `npm run db:up` (docker-compose Postgres on :5433).
# Every value here is a local placeholder: set real, random secrets in production (see docs/DEPLOY.md).
DATABASE_URL=postgres://clinic:clinic@localhost:5433/clinic
TEST_DATABASE_URL=postgres://clinic:clinic@localhost:5433/clinic_test
BETTER_AUTH_SECRET=local-dev-only-secret-replace-in-production
BETTER_AUTH_URL=http://localhost:3000
DEMO_MODE=1
DEMO_PASSWORD=change-me-demo-password
# Optional. Without a Resend key, emails are written to the server log instead of sent.
RESEND_API_KEY=
EMAIL_FROM=
IP_HASH_SECRET=
CRON_SECRET=
SITE_URL=http://localhost:3000
